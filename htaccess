# SPA-style: semua path section dilayani index.html
# Agar muhlishkipas.my.id/history tidak 404 saat refresh

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan rewrite file/folder yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Path section → index.html
  RewriteRule ^(download|topup|cek-akun|account|accountcheck|kalkulator|pricecalc|history|riwayat|faq|home)/?$ index.html [L]
</IfModule>
